# Copy this file to `.env` (same folder) and fill in your values.
# `.env` is git-ignored: it never goes to GitHub. Never put real values in
# this example file. On the hosting service the same names go into its
# environment-variable settings instead.

# ── Laptop only ──────────────────────────────────────────────────────────
# true: the backend starts its own database in data/ (no DB_URL needed).
DEV_MODE=true

# ── Database (needed in the cloud) ───────────────────────────────────────
DB_URL=
DB_USER=
DB_PASSWORD=

# ── Voice TURN relays (optional; peer-to-peer voice uses free STUN without them) ──
# Fixed TURN servers (comma-separated turn:/turns: URLs). Phones use whichever gets through.
# 1st: ExpressTURN free plan (1000 GB/month, port 3478).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# 2nd: Metered Open Relay free plan (20 GB/month, ports 80/443: gets through strict networks).
TURN2_URLS=
TURN2_USERNAME=
TURN2_CREDENTIAL=
# Optional: Cloudflare TURN key (1000 GB/month free, needs a card on file).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ── Push notifications (Firebase service-account JSON, on one line) ──────
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Admin dashboard (/admin) ─────────────────────────────────────────────
# A long random value only you know (32+ characters). Empty: dashboard closed.
ADMIN_TOKEN=

# ── Server error tracking (Sentry → Project → Settings → Client Keys) ───
# The project's DSN. Empty: errors only go to the server log.
SENTRY_DSN=

# ── Google Play Games sign-in (Play Console → Play Games Services → Credentials) ──
# The game server OAuth client. The id below is public; the secret is a real secret.
PLAY_GAMES_CLIENT_ID=532749629825-lflcpgr3pn64o7emjnvfdld8i0inpqhq.apps.googleusercontent.com
PLAY_GAMES_CLIENT_SECRET=

# ── Optional tuning ──────────────────────────────────────────────────────
MAX_ROOMS_PER_USER=5
COUNTDOWN_SECONDS=10
# City Bazaar rounds before the richest player wins (30; lower only for quick tests).
CITY_BAZAAR_ROUND_LIMIT=30
# Rounds added when the players vote to keep going at the round limit.
CITY_BAZAAR_EXTENSION_ROUNDS=30
# The City Bazaar bank's starting reserve (₹), shown in the app.
CITY_BAZAAR_BANK_START=300000
GUEST_CREATIONS_PER_HOUR=20
DISABLED_GAMES=
