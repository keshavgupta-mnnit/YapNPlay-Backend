# Copy to .env (git-ignored) or set these in the host's dashboard.
# Never put real passwords in this file or anywhere in git.
DEV_MODE=false
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USER=<user>
DB_PASSWORD=<password>
MAX_ROOMS_PER_USER=5
COUNTDOWN_SECONDS=10
GUEST_CREATIONS_PER_HOUR=20
DISABLED_GAMES=
